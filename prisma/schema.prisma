datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL") // uses connection pooling
  directUrl = env("POSTGRES_URL_NON_POOLING") // uses a direct connection
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id             String          @id @db.VarChar(50)
  name           String          @db.VarChar(100)
  email          String          @unique @db.VarChar(255)
  passwordHash   String          @map("password_hash") @db.VarChar(255)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamp()
  projects       Project[]
  timeEntries    TimeEntry[]
  invoices       Invoice[]
  paypalSettings PaypalSettings?

  @@map("timetracker_users")
}

model Project {
  id          String      @id @db.VarChar(50)
  userId      String      @map("user_id") @db.VarChar(50)
  name        String      @db.VarChar(100)
  clientName  String      @map("client_name") @db.VarChar(100)
  color       String      @db.VarChar(50)
  hourlyRate  Decimal     @default(0.00) @map("hourly_rate") @db.Decimal(10, 2)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks       Task[]
  timeEntries TimeEntry[]
  invoices    Invoice[]

  @@map("timetracker_projects")
}

model Task {
  id        String      @id @db.VarChar(50)
  projectId String      @map("project_id") @db.VarChar(50)
  name      String      @db.VarChar(100)
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  timeEntries TimeEntry[]

  @@map("timetracker_tasks")
}

model TimeEntry {
  id                 String    @id @db.VarChar(50)
  userId             String    @map("user_id") @db.VarChar(50)
  description        String    @db.Text
  projectId          String    @map("project_id") @db.VarChar(50)
  taskId             String?   @map("task_id") @db.VarChar(50)
  startTime          DateTime  @map("start_time") @db.Timestamp()
  endTime            DateTime? @map("end_time") @db.Timestamp()
  duration           Int       @default(0)
  isBillable         Boolean   @default(true) @map("is_billable")
  isInvoiceGenerated Boolean   @default(false) @map("is_invoice_generated")
  invoiceId          String?   @map("invoice_id") @db.VarChar(50)
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  project            Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task               Task?     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  invoice            Invoice?  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("timetracker_time_entries")
}

model Invoice {
  id            String      @id @db.VarChar(50)
  userId        String      @map("user_id") @db.VarChar(50)
  invoiceNumber String      @map("invoice_number") @db.VarChar(50)
  clientName    String      @map("client_name") @db.VarChar(100)
  clientEmail   String      @map("client_email") @db.VarChar(255)
  date          DateTime    @db.Date
  dueDate       DateTime    @map("due_date") @db.Date
  items         Json
  subtotal      Decimal     @default(0.00) @db.Decimal(10, 2)
  taxRate       Decimal     @default(0.00) @map("tax_rate") @db.Decimal(5, 2)
  taxAmount     Decimal     @default(0.00) @map("tax_amount") @db.Decimal(10, 2)
  discount      Decimal     @default(0.00) @db.Decimal(10, 2)
  total         Decimal     @default(0.00) @db.Decimal(10, 2)
  status        String      @default("Draft") @db.VarChar(50)
  projectId     String      @map("project_id") @db.VarChar(50)
  currency      String      @default("USD") @db.VarChar(10)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  project       Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  timeEntries   TimeEntry[]

  @@map("timetracker_invoices")
}

model PaypalSettings {
  userId   String @id @map("user_id") @db.VarChar(50)
  email    String @db.VarChar(255)
  clientId String @map("client_id") @db.VarChar(255)
  mode     String @default("sandbox") @db.VarChar(20)
  currency String @default("USD") @db.VarChar(10)
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("timetracker_paypal_settings")
}

model MerchantBillingSettings {
  id                  String   @id @default("primary") @db.VarChar(50)
  paybillNumber       String   @default("") @map("paybill_number") @db.VarChar(50)
  tillNumber          String   @default("") @map("till_number") @db.VarChar(50)
  bankName            String   @default("Lipa na M-Pesa (Paybill)") @map("bank_name") @db.VarChar(100)
  usdToKesRate        Decimal  @default(130.00) @map("usd_to_kes_rate") @db.Decimal(10, 2)
  paypalClientId      String   @default("test") @map("paypal_client_id") @db.VarChar(255)
  paypalMode          String   @default("sandbox") @map("paypal_mode") @db.VarChar(20)
  intasendPublicKey   String   @default("") @map("intasend_public_key") @db.VarChar(255)
  intasendLive        Boolean  @default(false) @map("intasend_live")
  intasendSecretKey   String   @default("") @map("intasend_secret_key") @db.VarChar(255)
  paystackPublicKey   String   @default("") @map("paystack_public_key") @db.VarChar(255)
  paystackLive        Boolean  @default(false) @map("paystack_live")
  paystackSecretKey   String   @default("") @map("paystack_secret_key") @db.VarChar(255)
  payheroApiUsername  String   @default("") @map("payhero_api_username") @db.VarChar(255)
  payheroApiPassword  String   @default("") @map("payhero_api_password") @db.VarChar(255)
  payheroChannelId    String   @default("") @map("payhero_channel_id") @db.VarChar(50)
  gravitypayPublicKey String   @default("") @map("gravitypay_public_key") @db.VarChar(255)
  gravitypaySecretKey String   @default("") @map("gravitypay_secret_key") @db.VarChar(255)
  gravitypayLive      Boolean  @default(true) @map("gravitypay_live")
  activeMpesaGateway  String   @default("payhero") @map("active_mpesa_gateway") @db.VarChar(30)

  @@map("timetracker_merchant_billing_settings")
}

model SubscriptionPayment {
  id              String   @id @db.VarChar(50)
  userId          String   @map("user_id") @db.VarChar(50)
  planTier        String   @map("plan_tier") @db.VarChar(30)
  amount          Decimal  @db.Decimal(10, 2)
  paymentMethod   String   @map("payment_method") @db.VarChar(20)
  transactionCode String   @map("transaction_code") @db.VarChar(50)
  status          String   @default("pending") @db.VarChar(20)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamp()

  @@map("timetracker_subscription_payments")
}

